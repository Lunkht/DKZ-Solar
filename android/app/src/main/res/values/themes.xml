<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SolarGreen" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Couleurs de base -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface_custom</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Barre de statut et navigation -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>

        <!-- Compatibilité BottomNav -->
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>

        <!-- Désactiver les effets Material 3 par défaut -->
        <item name="textAppearanceHeadlineMedium">@style/TextHeadline</item>
        <item name="textAppearanceBodyMedium">@style/TextBody</item>
    </style>

    <style name="TextHeadline">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextBody">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="SpinnerSolarGreen" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_dim</item>
    </style>

    <style name="SolarGreenDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:colorBackground">@color/surface_custom</item>
        <item name="colorSurface">@color/surface_custom</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent</item>
    </style>
</resources>